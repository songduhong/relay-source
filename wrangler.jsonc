{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sourcingrelay",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sourcing-relay-db",
      "database_id": "e27d00af-620b-455f-aad2-f312964c3a73",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "sourcing-relay-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
